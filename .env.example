# Copy this file to .env and fill in the values

NEXT_TELEMETRY_DISABLED=1

# Container: file:/data/homecenter.db  |  Local: file:./prisma/dev.db
DATABASE_URL="file:/data/homecenter.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Container: /data/uploads  |  Local: ./uploads
UPLOAD_DIR="/data/uploads"
MAX_UPLOAD_BYTES="26214400"

# Initial admin account (used by npm run db:seed)
# If not set, seed uses admin@localhost / changeme and forces a password reset on first login.
# ADMIN_NAME="Your Name"
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="your-secure-password"
